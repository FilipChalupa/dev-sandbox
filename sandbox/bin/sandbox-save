#!/usr/bin/env bash
# Usage: sandbox-save [--skip-checks] [--auto] [message]
# Commits everything and pushes the working branch. Used by the autosave loop
# (--auto), by the "Send to developer" button and by Claude. Refuses to touch
# a repository in the middle of a merge or rebase.
#
# One save at a time (9. 10. 2026): the three used to run into each other
# and a git killed halfway left its index.lock behind, which then blocked
# every git command. A second save waits for the first (exit 7 after five
# minutes); --auto skips the round instead (exit 0), and also skips while
# git is busy (a lock less than two minutes old, usually Claude committing),
# while dependencies are being installed, and while files are still
# changing — it saves once nothing changed for SANDBOX_AUTOSAVE_QUIET_SECONDS
# (default 120), or anyway after SANDBOX_AUTOSAVE_MAX_WAIT_MINUTES (default
# 30) of postponing. A lock left behind by a git that died is removed first
# (sandbox-git-unlock). --auto implies --skip-checks.
#
# Before pushing it brings in what the server has on the branch (the developer
# merges main back into it after each takeover): fetch + merge, never rebase.
# When that merge conflicts, the sandbox's version wins: the merge is aborted
# and the branch on the server is replaced with the sandbox's state (only what
# was just fetched, --force-with-lease); the developer redoes the merge of
# main later, with the conflict resolved on their side. The overwritten
# commit is recorded so nothing is lost. Then the project's lint and typecheck
# scripts run when it has them; if they fail the commit stays local (exit 5)
# unless --skip-checks is given. Exit 4: push rejected for another reason.
# The outcome is written to push-status.json.
set -uo pipefail
source sandbox-lib
skip_checks=0
auto=0
while [ $# -gt 0 ]; do
	case "$1" in
		--skip-checks) skip_checks=1; shift ;;
		--auto) auto=1; skip_checks=1; shift ;;
		*) break ;;
	esac
done
cd "$SANDBOX_WORKSPACE" || exit 1
[ -d .git ] || { echo "not a git repository"; exit 1; }
if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ] || [ -f .git/MERGE_HEAD ]; then
	echo "merge or rebase in progress, not saving"; exit 2
fi

# --- one save at a time ---------------------------------------------------
exec 8> "$(state_file save.lock)"
if ! flock -n 8; then
	[ "$auto" = 1 ] && { echo "another save is running, skipping this round"; exit 0; }
	echo "another save is running (autosave, the Send button or Claude); waiting for it…"
	flock -w 300 8 || { echo "the other save is still running after 5 minutes, try again later"; exit 7; }
fi

# A lock left behind by a git that died goes; a fresh one belongs to a git
# that is working right now (Claude committing by hand).
sandbox-git-unlock >/dev/null 2>&1 || true
if [ -f .git/index.lock ]; then
	[ "$auto" = 1 ] && { echo "git is busy, skipping this round"; exit 0; }
	for _ in $(seq 1 30); do [ -f .git/index.lock ] || break; sleep 1; done
	[ -f .git/index.lock ] && { echo "git is busy with another command (.git/index.lock), try again in a moment"; exit 8; }
fi

if [ "$auto" = 1 ]; then
	# An install changes the lockfile and node_modules: not a moment to commit.
	if ! (flock -n 9) 9> "$(state_file deps.lock)"; then
		echo "dependencies are being installed, skipping this round"; exit 0
	fi
	# Save in a quiet moment, not in the middle of Claude's edits.
	quiet="${SANDBOX_AUTOSAVE_QUIET_SECONDS:-120}"
	max_wait=$(( ${SANDBOX_AUTOSAVE_MAX_WAIT_MINUTES:-30} * 60 ))
	now="$(date +%s)"
	newest=0
	while IFS= read -r -d '' entry; do
		[ "${#entry}" -gt 3 ] || continue
		t="$(stat -c %Y -- "${entry:3}" 2>/dev/null || echo 0)"
		[ "$t" -gt "$newest" ] && newest="$t"
	done < <(git --no-optional-locks status --porcelain -z 2>/dev/null)
	if [ "$newest" -gt 0 ] && [ $((now - newest)) -lt "$quiet" ]; then
		since="$(read_state autosave-waiting-since)"
		[ -n "$since" ] || { since="$now"; write_state autosave-waiting-since "$now"; }
		if [ $((now - since)) -lt "$max_wait" ]; then
			echo "files are still changing, saving later"; exit 0
		fi
		echo "files keep changing for $(( (now - since) / 60 )) minutes, saving anyway"
	fi
	rm -f "$(state_file autosave-waiting-since)"
fi
git config user.email >/dev/null 2>&1 || sandbox-git-identity >/dev/null 2>&1 || { echo "no git identity yet (Claude not logged in?)"; exit 3; }
trap 'sandbox-status-write' EXIT
push_status() { jq -n -c --argjson ok "$1" --arg reason "$2" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg detail "${3:-}" '{ok:$ok, reason:$reason, at:$at, detail:$detail}' > "$(state_file push-status.json)"; }
msg="${1:-wip: autosave $(date '+%Y-%m-%d %H:%M')}"
if [ -n "$(git --no-optional-locks status --porcelain)" ]; then
	git add -A
	git commit -q -m "$msg" && echo "committed: $msg"
fi
if git remote get-url origin >/dev/null 2>&1 && git rev-parse --verify -q HEAD >/dev/null; then
	# The server may be ahead (the developer merged main into this branch).
	if GIT_TERMINAL_PROMPT=0 git fetch -q origin "$SANDBOX_BRANCH" 2>/dev/null \
		&& ! git merge-base --is-ancestor "origin/$SANDBOX_BRANCH" HEAD 2>/dev/null; then
		echo "the server has new commits on $SANDBOX_BRANCH, merging them in…"
		if git merge --no-edit "origin/$SANDBOX_BRANCH" >/dev/null 2>&1; then
			echo "merged origin/$SANDBOX_BRANCH"
			event merge "new commits from the server merged in before sending (the developer usually merged the main branch): $(git log -1 --format='%h %s' "origin/$SANDBOX_BRANCH")"
			# The merge may bring new or upgraded packages: install them before
			# the checks below (they would fail on stale node_modules) and
			# restart the dev server so the preview runs on them.
			# 8>&-: the restarted project server must not inherit (and hold) the save lock.
			sandbox-deps --restart --quiet 8>&- || echo "dependency install failed (see deps.log)"
		else
			git merge --abort 2>/dev/null || true
			overwritten="$(git rev-parse --short "origin/$SANDBOX_BRANCH")"
			echo "CONFLICT: the server's version of $SANDBOX_BRANCH ($overwritten) conflicts with the changes here."
			echo "replacing the server's version with this sandbox's; the developer merges main again later."
			if out="$(SANDBOX_ALLOW_OVERWRITE=1 git push --force-with-lease="$SANDBOX_BRANCH:origin/$SANDBOX_BRANCH" -u origin "$SANDBOX_BRANCH" 2>&1)"; then
				printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "overwrote" "$overwritten" "server version replaced after a merge conflict" >> "$(state_file sends.log)"
				event conflict "the server's branch conflicted and was replaced with this sandbox's ($overwritten overwritten); the developer merges again"
				push_status true overwrote "server had $overwritten; replaced with $(git rev-parse --short HEAD). The developer needs to merge main into the branch again."
				echo "pushed $SANDBOX_BRANCH (server version $overwritten replaced)"
				exit 0
			fi
			push_status false conflict "could not replace the server's version: $(tail -n 1 <<<"$out")"
			echo "could not push: $(tail -n 2 <<<"$out")"
			exit 6
		fi
	fi
	if ! git rev-parse --verify -q '@{u}' >/dev/null 2>&1 || [ -n "$(git rev-list '@{u}..HEAD' 2>/dev/null)" ]; then
		if [ "$skip_checks" = 0 ] && [ -f package.json ] && [ -d node_modules ]; then
			pm="$(package_manager)"
			for check in lint typecheck; do
				jq -e --arg c "$check" '.scripts[$c]' package.json >/dev/null 2>&1 || continue
				echo "running $check…"
				if ! out="$(timeout 300 "$pm" run "$check" 2>&1)"; then
					push_status false checks "$check failed"
					echo "CHECK FAILED ($check):"
					tail -n 12 <<<"$out"
					echo "committed locally, not pushed. Ask Claude to fix the $check errors, or send anyway."
					exit 5
				fi
			done
		fi
		count="$(git rev-list --count '@{u}..HEAD' 2>/dev/null || git rev-list --count HEAD)"
		if out="$(git push -u origin "$SANDBOX_BRANCH" 2>&1)"; then
			# History for the UI: time, commits sent, head, subject.
			printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$count" "$(git rev-parse --short HEAD)" "$(git log -1 --format=%s)" >> "$(state_file sends.log)"
			jq -n -c --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{ok:true, at:$at, error:""}' > "$(state_file remote-check.json)"
			push_status true pushed ""
			event send "sent to the developer: $count commit(s), $(git log -1 --format='%h %s')"
			echo "pushed $SANDBOX_BRANCH"
		else
			if grep -qiE "authentication|denied|403|401|could not read|not found" <<<"$out"; then
				jq -n -c --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg e "$(tail -n 1 <<<"$out")" '{ok:false, at:$at, error:$e}' > "$(state_file remote-check.json)"
				push_status false auth "$(tail -n 1 <<<"$out")"
			else
				push_status false rejected "$(tail -n 1 <<<"$out")"
			fi
			echo "push failed: $(tail -n 3 <<<"$out")"; exit 4
		fi
	else
		push_status true nothing ""
		echo "nothing to push"
	fi
else
	echo "no remote configured, saved locally only"
fi
