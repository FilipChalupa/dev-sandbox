#!/usr/bin/env bash
# Usage: repo_url=<https url> sandbox-git-prepare
# The repository part of the container start: clone when there is nothing
# yet, point origin at the configured URL, check out the working branch and
# fast-forward it to the server. A separate script (9. 10. 2026) so that the
# entrypoint can survive its failure: a git lock left behind made
# `git checkout` fail and, under `set -e`, stopped the whole start — no
# Claude, no preview, nothing to fix it with. Exit 3: the first clone failed
# (no project at all, the start stops as before); any other failure is
# reported and the sandbox starts anyway.
set -euo pipefail
source sandbox-lib
repo_url="${repo_url:-}"

cd "$SANDBOX_WORKSPACE"
# Nothing else runs yet, so any lock is left over from the last stop.
sandbox-git-unlock --force >/dev/null || true
cd "$SANDBOX_WORKSPACE"
# A start interrupted in the middle of init/clone leaves a broken .git behind.
if [ -d .git ] && ! git rev-parse --git-dir >/dev/null 2>&1; then
	log "repository metadata is broken, setting it up again"
	rm -rf .git
	repair=1
fi
if [ ! -d .git ]; then
	if [ -n "$repo_url" ]; then
		log "cloning $repo_url"
		git init -q .
		git remote add origin "$repo_url"
		if ! out="$(GIT_TERMINAL_PROMPT=0 git fetch -q origin 2>&1)"; then
			log "CLONE FAILED: $(tail -n 2 <<<"$out" | tr '\n' ' ')"
			rm -rf .git
			exit 3
		fi
		git remote set-head origin -a >/dev/null 2>&1 || true
		default="$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')"
		# -f: files from an interrupted earlier clone may already be in the way
		[ -n "$default" ] && git checkout -q -f "$default" 2>/dev/null || true
	else
		log "no repository URL, starting an empty project"
		git init -q -b "$SANDBOX_BRANCH" .
		cp /opt/sandbox/templates/gitignore .gitignore
	fi
fi
if [ -n "$repo_url" ]; then
	if git remote get-url origin >/dev/null 2>&1; then
		git remote set-url origin "$repo_url"
	else
		git remote add origin "$repo_url"
	fi
fi
if git show-ref --verify --quiet "refs/heads/$SANDBOX_BRANCH"; then
	git checkout -q "$SANDBOX_BRANCH"
	# Bring in what the server has on the branch when it is a plain fast-forward
	# (the developer merged main into it); anything else waits for sandbox-save.
	if git remote get-url origin >/dev/null 2>&1 && [ -z "$(git --no-optional-locks status --porcelain --untracked-files=no)" ] \
		&& GIT_TERMINAL_PROMPT=0 git fetch -q origin "$SANDBOX_BRANCH" 2>/dev/null; then
		if git merge -q --ff-only "origin/$SANDBOX_BRANCH" 2>/dev/null; then
			log "branch fast-forwarded to origin/$SANDBOX_BRANCH"
			event merge "the sandbox started and took over new commits from the server (the developer usually merged the main branch in): $(git log -1 --format='%h %s')"
		elif ! git merge-base --is-ancestor "origin/$SANDBOX_BRANCH" HEAD 2>/dev/null; then
			log "origin/$SANDBOX_BRANCH has diverged; sandbox-save merges it before the next push"
		fi
	fi
elif git remote get-url origin >/dev/null 2>&1 \
	&& git ls-remote --exit-code --heads origin "$SANDBOX_BRANCH" >/dev/null 2>&1; then
	git fetch -q origin "$SANDBOX_BRANCH"
	git checkout -q -b "$SANDBOX_BRANCH" --track "origin/$SANDBOX_BRANCH"
elif git rev-parse --verify -q HEAD >/dev/null; then
	git checkout -q -b "$SANDBOX_BRANCH"
else
	git symbolic-ref HEAD "refs/heads/$SANDBOX_BRANCH"
fi
