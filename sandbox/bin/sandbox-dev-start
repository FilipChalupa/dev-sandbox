#!/usr/bin/env bash
# Usage: sandbox-dev-start [--restart]
# Starts the project server the way Claude set it up (the project_server tool
# of sandbox-mcp writes project-server.json), in a tmux session "dev" so it
# survives this command. The sandbox does not guess any more: it used to try
# package.json scripts and fall back to a hidden Claude run, which picked
# the wrong command often enough (October 2026). Claude decides once, the
# sandbox repeats it after a restart, after the developer's merge and from
# the manager's button. Dependencies are brought up to date first.
# Exit 3: Claude has not set up the project server yet.
set -uo pipefail
source sandbox-lib
cd "$SANDBOX_WORKSPACE" || exit 1

if [ "${1:-}" = "--restart" ]; then
	sandbox-dev-stop >/dev/null 2>&1
elif tmux has-session -t dev 2>/dev/null; then
	echo "the project server is running already (sandbox-dev-stop stops it)"
	exit 0
fi

cmd="$(jq -r '.command // empty' "$(state_file project-server.json)" 2>/dev/null)"
if [ -z "$cmd" ]; then
	echo "Claude has not set up how to run this project yet. Ask Claude to start the website."
	exit 3
fi

wait_for_port() {
	for _ in $(seq 1 "${1:-60}"); do
		p="$(sandbox-ports | head -n 1)"
		[ -n "$p" ] && { echo "$p"; return 0; }
		sleep 1
	done
	return 1
}

# Missing or stale dependencies (a merge brought new packages); a failed
# install still lets the server try with what is there.
[ -f package.json ] && { sandbox-deps --quiet || echo "dependency install failed, starting anyway (see deps.log)"; }

# The command goes into a file: any quoting in it survives, and a login
# shell picks the project's Node version (fnm) like Claude's own shell.
runner="$(state_file project-server.sh)"
printf 'cd %q\n%s\n' "$SANDBOX_WORKSPACE" "$cmd" > "$runner"
echo "starting: $cmd"
: > "$(state_file dev.log)"
tmux new-session -d -s dev -c "$SANDBOX_WORKSPACE" "bash -l $runner 2>&1 | tee -a $(state_file dev.log)"
if port="$(wait_for_port 90)"; then
	write_state upstream-port "$port"
	sandbox-caddy-reload >/dev/null 2>&1 || true
	rm -f "$(state_file preview.png)"   # the thumbnail loop shoots a fresh one
	sandbox-status-write
	echo "the project server listens on port $port, preview: $SANDBOX_PREVIEW_URL"
	exit 0
fi
echo "nothing started listening within 90 s; last output:"
tail -n 15 "$(state_file dev.log)"
exit 1
