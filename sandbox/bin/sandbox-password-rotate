#!/usr/bin/env bash
# Generates a new preview password and makes Caddy use it right away.
# Anyone holding the old one (a client who should no longer see the site)
# is locked out at once; the shared URL itself stays.
set -euo pipefail
source sandbox-lib
unset SANDBOX_PREVIEW_PASSWORD
rm -f "$(state_file preview-password)"
pw="$(preview_password)"
write_state preview-password "$pw"
chmod 600 "$(state_file preview-password)"
sandbox-caddy-reload >/dev/null
sandbox-status-write
echo "new password: $pw"
