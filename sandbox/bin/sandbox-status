#!/usr/bin/env bash
# Prints the sandbox status as JSON (what the manager UI shows).
set -uo pipefail
source sandbox-lib
cd "$SANDBOX_WORKSPACE" 2>/dev/null || true

auth="$(claude auth status 2>/dev/null || true)"   # exits 1 when logged out, still prints JSON
printf '%s' "$auth" | jq -e . >/dev/null 2>&1 || auth='{}'
logged_in="$(printf '%s' "$auth" | jq -r 'if .loggedIn == true then "true" else "false" end')"
email="$(printf '%s' "$auth" | jq -r '.email // empty')"
if pgrep -f 'claude remote-control' >/dev/null 2>&1; then running=true; else running=false; fi
if [ -d .git ]; then
	dirty="$(git --no-optional-locks status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
	branch="$(git branch --show-current 2>/dev/null)"
	ahead="$(git rev-list '@{u}..HEAD' 2>/dev/null | wc -l | tr -d ' ')"
	last="$(git log -1 --format='%h %s' 2>/dev/null)"
	remote="$(git remote get-url origin 2>/dev/null)"
	# What changed today: commits since midnight and the files touched now.
	today="$(git log --since=midnight --format='%h %s' 2>/dev/null | head -n 30 | jq -R . | jq -s .)"
	changed="$(git --no-optional-locks status --porcelain 2>/dev/null | head -n 40 | cut -c4- | jq -R . | jq -s .)"
	shortstat="$(git --no-optional-locks diff --shortstat 2>/dev/null | sed 's/^ *//')"
	sends="$(tail -n 20 "$(state_file sends.log)" 2>/dev/null | jq -R 'split("\t") | {at: .[0], count: (.[1] | tonumber? // 0), sha: .[2], subject: .[3]}' | jq -s 'reverse')"
else
	dirty=0; branch=""; ahead=0; last=""; remote=""; today='[]'; changed='[]'; shortstat=""; sends='[]'
fi
if tunnel_running; then tunnel="$(tunnel_url)"; else tunnel=""; fi
if grep -qx "$(upstream_port)" <<<"$(sandbox-ports)"; then dev_up=true; else dev_up=false; fi
if tmux has-session -t claude 2>/dev/null; then tmux_up=true; else tmux_up=false; fi
if curl -fs -o /dev/null http://localhost:2019/config/ 2>/dev/null; then caddy_up=true; else caddy_up=false; fi
thumb_at=0; [ -f "$(state_file preview.png)" ] && thumb_at="$(stat -c %Y "$(state_file preview.png)")"
# Activity: Claude appends to a session transcript whenever it works. The
# server's own terminal output changes even when idle and the git index is
# touched by every start, so neither counts.
activity=0
transcripts="$CLAUDE_CONFIG_DIR/projects/$(printf '%s' "$SANDBOX_WORKSPACE" | tr '/' '-')"
for f in "$transcripts"/*.jsonl "$(state_file tunnel-url)"; do
	[ -s "$f" ] || continue   # the server pre-creates an empty transcript on every start
	m="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
	[ "$m" -gt "$activity" ] && activity="$m"
done

jq -n \
	--arg name "$SANDBOX_NAME" \
	--arg branch "${branch:-$SANDBOX_BRANCH}" \
	--arg remote "$remote" \
	--arg session "$(session_url)" \
	--arg preview "$SANDBOX_PREVIEW_URL" \
	--arg tunnel "$tunnel" \
	--arg port "$(upstream_port)" \
	--arg user "$SANDBOX_PREVIEW_USER" \
	--arg pw "$(preview_password)" \
	--argjson loggedIn "$logged_in" \
	--arg email "$email" \
	--argjson running "$running" \
	--argjson devUp "$dev_up" \
	--argjson tmuxUp "$tmux_up" \
	--argjson caddyUp "$caddy_up" \
	--argjson thumbAt "$thumb_at" \
	--argjson lastActivity "$activity" \
	--argjson dirty "${dirty:-0}" \
	--argjson ahead "${ahead:-0}" \
	--arg last "$last" \
	--argjson today "${today:-[]}" \
	--argjson changed "${changed:-[]}" \
	--arg shortstat "$shortstat" \
	--argjson sends "${sends:-[]}" \
	--argjson lanEnabled "$(lan_enabled && echo true || echo false)" \
	'{
		name: $name,
		git: { branch: $branch, remote: $remote, dirty: $dirty, ahead: $ahead, lastCommit: $last, today: $today, changed: $changed, shortstat: $shortstat, sends: $sends },
		claude: { loggedIn: $loggedIn, email: $email, serverRunning: $running, supervisorRunning: $tmuxUp, sessionUrl: $session },
		preview: { url: $preview, upstreamPort: ($port | tonumber), devServerUp: $devUp, proxyUp: $caddyUp, lanEnabled: $lanEnabled, imageAt: (if $thumbAt > 0 then ($thumbAt | todate) else "" end), tunnelUrl: $tunnel, user: $user, password: $pw },
		lastActivity: (if $lastActivity > 0 then ($lastActivity | todate) else "" end),
		updatedAt: (now | todate)
	}'
