#!/usr/bin/env bash
# Container entrypoint: prepare the repository, git credentials and identity,
# the rules file for Claude, then start Caddy, the Claude Remote Control
# server (in tmux), the autosave loop and the status writer.
set -euo pipefail
env_branch="${SANDBOX_BRANCH:-}"   # the manager's configuration wins at start
source sandbox-lib
[ -n "$env_branch" ] && SANDBOX_BRANCH="$env_branch"
export SANDBOX_BRANCH

mkdir -p "$SANDBOX_STATE_DIR" "$SANDBOX_WORKSPACE" "$CLAUDE_CONFIG_DIR"
chmod 700 "$SANDBOX_STATE_DIR" 2>/dev/null || true

# --- preview password ---------------------------------------------------
pw="$(preview_password)"
write_state preview-password "$pw"
chmod 600 "$(state_file preview-password)"

# --- git: URL, credentials ------------------------------------------------
repo_url="${SANDBOX_REPO_URL:-}"
token="${SANDBOX_GIT_TOKEN:-$(read_state git-token)}"
repo_url="$(to_https_url "$repo_url")"   # token auth needs https
# Runtime-changeable settings live in files; the environment seeds them.
write_state autosave-minutes "${SANDBOX_AUTOSAVE_MINUTES:-10}"
write_state lan-enabled "${SANDBOX_LAN_PREVIEW:-1}"
git config --global safe.directory '*'
git config --global init.defaultBranch main
git config --global push.autoSetupRemote true
git config --global pull.rebase false
git config --global core.hooksPath /opt/sandbox/hooks   # our guard; the repository's own hooks do not run
write_state branch "$SANDBOX_BRANCH"
if [ -n "$repo_url" ] && [ -n "$token" ]; then
	host="$(printf '%s' "$repo_url" | sed -E 's#^https?://([^/]+).*#\1#')"
	user="${SANDBOX_GIT_USERNAME:-$(git_username_for "$host")}"
	printf 'https://%s:%s@%s\n' "$user" "$token" "$host" > "$(state_file git-credentials)"
	chmod 600 "$(state_file git-credentials)"
	git config --global credential.helper "store --file=$(state_file git-credentials)"
fi

# --- git: repository and branch -------------------------------------------
cd "$SANDBOX_WORKSPACE"
rc=0
repo_url="$repo_url" sandbox-git-prepare || rc=$?
[ "$rc" = 3 ] && exit 3
if [ "$rc" != 0 ]; then
	# Start anyway: Claude and the preview are how the person fixes things.
	log "GIT NOT READY (exit $rc), starting anyway; see the lines above"
	event git-error "the repository could not be prepared at start (exit $rc); the sandbox started anyway — run the sandbox check"
fi
log "on branch $(git branch --show-current 2>/dev/null || echo '?')"
event start "sandbox started on branch $(git branch --show-current 2>/dev/null), project files $([ "${SANDBOX_HOST_FOLDER:-0}" = 1 ] && echo 'in a folder on the computer' || echo 'inside Docker')"

sandbox-git-identity || true

# Node version the project asks for (.nvmrc, .node-version, engines.node):
# install it now in the background so the first command does not wait.
# Dependencies are installed only on the way to the project server
# (sandbox-dev-start) or by Claude, never on their own: an install nobody
# watched collided with Claude's and its failure went unseen.
# Then the project server, when Claude has set it up (project_server tool):
# after a restart the preview works without anyone asking.
(
	sandbox-node-prepare >> "$(state_file fnm.log)" 2>&1
	[ -s "$(state_file project-server.json)" ] && sandbox-dev-start >> "$(state_file dev-start.log)" 2>&1
) &
# An install cut off by the last stop is not running any more.
grep -q '"installing"' "$(state_file deps-status.json)" 2>/dev/null && rm -f "$(state_file deps-status.json)"

# Claude asks once per directory whether to trust it, and once whether to
# enable Remote Control. Nobody sits at this terminal, so answer up front.
cfg="$CLAUDE_CONFIG_DIR/.claude.json"
[ -s "$cfg" ] && jq -e . "$cfg" >/dev/null 2>&1 || echo '{}' > "$cfg"
jq --arg ws "$SANDBOX_WORKSPACE" '
	.projects[$ws].hasTrustDialogAccepted = true
	| .remoteDialogSeen = true
	| .hasCompletedOnboarding = true
	| .mcpServers.sandbox = { command: "sandbox-mcp", args: [] }
	| .mcpServers.playwright = {
		command: "playwright-mcp",
		args: ["--headless", "--isolated", "--no-sandbox", "--executable-path", "/usr/bin/chromium", "--viewport-size", "1280x800", "--output-dir", "/tmp/playwright-mcp"]
	}
' "$cfg" > "$cfg.tmp" && mv "$cfg.tmp" "$cfg"

# --- rules for Claude, kept out of the repository -------------------------
sandbox-rules-write >/dev/null
mkdir -p .git/info
grep -qx 'CLAUDE.local.md' .git/info/exclude 2>/dev/null || echo 'CLAUDE.local.md' >> .git/info/exclude
# pnpm used to keep its store inside the project (.pnpm-store); the package
# cache is a shared volume now (npm_config_store_dir). An old untracked store
# is just a cache: drop it, it once ended up committed with 30 000 files.
if [ -n "${npm_config_store_dir:-}" ] && [ -d .pnpm-store ] && [ -z "$(git ls-files -- .pnpm-store | head -n 1)" ]; then
	log "removing the old package store inside the project (.pnpm-store)"
	rm -rf .pnpm-store &   # in the background: on a shared folder it takes minutes
fi
for x in .env .playwright-mcp/ .pnpm-store/; do
	grep -qx "$x" .git/info/exclude 2>/dev/null || echo "$x" >> .git/info/exclude
done

# --- services -------------------------------------------------------------
# Each service runs in the background; the loop at the end restarts any that
# died. Claude's server has its own loop inside tmux.
declare -A svc_cmd svc_pid
start_service() { svc_cmd[$1]="$2"; bash -c "${svc_cmd[$1]}" & svc_pid[$1]=$!; }

trap 'log "shutting down"; sandbox-unshare >/dev/null 2>&1 || true; tmux kill-server 2>/dev/null || true; kill "${svc_pid[@]}" 2>/dev/null || true; exit 0' TERM INT

sandbox-caddy-reload >/dev/null
start_service caddy "exec caddy run --config $(state_file Caddyfile) >> $(state_file caddy.log) 2>&1"
start_service autosave "exec sandbox-autosave >> $(state_file autosave.log) 2>&1"
start_service status "exec sandbox-status-loop"
start_service ports "exec sandbox-port-watch >> $(state_file port-watch.log) 2>&1"
start_service thumb "exec sandbox-thumb-loop >> $(state_file thumb.log) 2>&1"
start_service remote "exec sandbox-remote-loop >> $(state_file remote.log) 2>&1"
start_service usage "exec sandbox-usage-loop >> $(state_file usage.log) 2>&1"
sandbox-claude-start >/dev/null

# Sharing was on before this restart: bring the tunnel back (new URL).
if [ -s "$(state_file tunnel-url)" ]; then
	rm -f "$(state_file cloudflared.pid)"
	(sleep 5; sandbox-share >> "$(state_file cloudflared.log)" 2>&1 && log "sharing restored: $(tunnel_url)") &
fi

log "sandbox '$SANDBOX_NAME' is up; preview password for user '$SANDBOX_PREVIEW_USER' is in $(state_file preview-password)"
while true; do
	sleep 10
	for name in "${!svc_cmd[@]}"; do
		if ! kill -0 "${svc_pid[$name]}" 2>/dev/null; then
			log "service $name died, restarting"
			bash -c "${svc_cmd[$name]}" & svc_pid[$name]=$!
		fi
	done
	tmux has-session -t claude 2>/dev/null || { log "claude tmux session gone, restarting"; sandbox-claude-start >/dev/null; }
done
