# Generated by sandbox-caddy-reload. Do not edit.
{
	admin localhost:2019
	auto_https off
}

(proxy) {
	reverse_proxy 127.0.0.1:${PORT} {
		${HEADER_UP}
	}
}

(errors) {
	handle_errors 502 503 {
		respond "Nothing is listening on port ${PORT} in the sandbox yet. Ask Claude to start the dev server (and to run `sandbox-preview <port>` if it uses a different port)." 502
	}
}

# Local preview, published on the host as 127.0.0.1:<port>.
:8080 {
	import proxy
	import errors
}

# Basic-auth preview: the Cloudflare tunnel (from inside the container) and,
# when enabled, phones on the local network through the published port.
:8081 {
	@inside remote_ip 127.0.0.1 ::1
	handle @inside {
		basic_auth {
			${USER} ${HASH}
		}
		import proxy
	}
	handle {
		${LAN_BLOCK}
	}
	import errors
}
